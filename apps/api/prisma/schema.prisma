  buyerEmail         String
  message            String
  ipAddress          String?        // Saved for rate-limiting & anti-spam checks
  communicationGranted Boolean        @default(false) // KVKK / GDPR compliance consent
  replyMessage       String?
  repliedAt          DateTime?
  
  createdAt          DateTime       @default(now())
  
  @@index([listingId])
  @@index([buyerId])
}

model ListingView {
  id          String         @id @default(uuid())
