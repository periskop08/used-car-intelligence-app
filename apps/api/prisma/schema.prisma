  archivedAt            DateTime?

  listing               VehicleListing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              ListingAiMessage[]

  @@unique([listingId, userId])
  @@index([userId, updatedAt])
}

model ListingAiMessage {
  id              String               @id @default(cuid())
  conversationId  String
  role            String               // USER | ASSISTANT | SYSTEM
  messageType     ListingAiMessageType @default(USER_MESSAGE)
  content         String
  quotaUsageId    String?
  listingVersion  Int?
  contextHash     String?
  createdAt       DateTime             @default(now())

  conversation    ListingAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quotaUsage      AiQuotaUsage?         @relation(fields: [quotaUsageId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model AiQuotaUsage {
  id                 String             @id @default(cuid())
  userId             String
  feature            AiQuotaFeature     @default(LISTING_AI_ADVISOR)
  referenceId        String?
  idempotencyKey     String             @unique
  assistantMessageId String?
  status             AiQuotaUsageStatus @default(RESERVED)
  amount             Int                @default(1)
  reservedAt         DateTime           @default(now())
  consumedAt         DateTime?
  releasedAt         DateTime?
  expiresAt          DateTime
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           ListingAiMessage[]

  @@index([userId, feature, status, createdAt])
  @@index([referenceId])
}

enum ListingPromotionType {
  URGENT_LISTING
  SHOWCASE_FEED
}

enum ListingPromotionProductSku {
  URGENT_LISTING
  SHOWCASE_FEED
  URGENT_SHOWCASE_BUNDLE
}

enum ListingPromotionSource {
  PAYMENT
  ADMIN_GRANT
  CAMPAIGN
}

enum PromotionRefundMethod {
  ORIGINAL_PAYMENT
  ACCOUNT_CREDIT
}

enum PromotionLifecycleStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum PromotionPaymentStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  PAID
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
  CHARGEBACK
  REVERSED
  FAILED
}

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model ListingPromotionQuote {
  id             String                     @id @default(cuid())
  userId         String
  listingId      String
  promotionType  ListingPromotionType       @default(URGENT_LISTING)
  productSku     ListingPromotionProductSku @default(URGENT_LISTING)
  priceAmount    Decimal                    @db.Decimal(12, 2)
  amountMinor    Int
  currency       String                     @default("TRY")
  pricingVersion String

  taxIncluded    Boolean                    @default(true)
  taxRate        Decimal?                   @db.Decimal(5, 2)
  termsVersion   String

  expiresAt      DateTime
  consumedAt     DateTime?

  createdAt      DateTime                   @default(now())

  purchase       ListingPromotionPurchase?

  @@index([userId, listingId, promotionType])
  @@index([expiresAt])
}

model ListingPromotionPurchase {
  id                      String                     @id @default(cuid())
  userId                  String?
  listingId               String?
  source                  ListingPromotionSource     @default(PAYMENT)
  promotionType           ListingPromotionType       @default(URGENT_LISTING)
  productSku              ListingPromotionProductSku @default(URGENT_LISTING)
  
  lifecycleStatus         PromotionLifecycleStatus   @default(PENDING_ACTIVATION)
  paymentStatus           PromotionPaymentStatus     @default(PENDING)

  // 1-to-1 Quote Relation
  quoteId                 String?                    @unique
  quote                   ListingPromotionQuote?     @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  // Entitlements
  entitlements            ListingPromotionEntitlement[]

  // Pricing & Tax Snapshots
  priceAmount             Decimal?                   @db.Decimal(12, 2)
  amountMinor             Int?
  currency                String?                    @default("TRY")
  pricingVersion          String?
  taxIncluded             Boolean                    @default(true)
  taxRate                 Decimal?                   @db.Decimal(5, 2)

  // Financial & User Snapshots
  listingPublicIdSnapshot String?
  listingTitleSnapshot    String?
  buyerReferenceSnapshot  String?
  campaignId              String?

  // Payment Metadata
  paymentProvider         String?
  paymentReferenceId      String?
  paymentIdempotencyKey   String?                    @unique
  checkoutExpiresAt       DateTime?

  // User Consent Snapshots
  termsVersion            String?
  consentedAt             DateTime?

  // Timestamps
  purchasedAt             DateTime?
  activatedAt             DateTime?
  expiresAt               DateTime?
  cancelledAt             DateTime?
  terminatedAt            DateTime?
  refundedAt              DateTime?

  // Refund Tracking & Idempotency
  refundMethod            PromotionRefundMethod?
  refundIdempotencyKey    String?                    @unique
  refundReferenceId       String?
  refundedAmount          Decimal?                   @db.Decimal(12, 2)
  refundedAmountMinor     Int?
  rejectionReason         String?
  refundReason            String?

  // Errors & Admin Grant
  lastErrorCode           String?
  lastErrorMessage        String?
  grantedByAdminId        String?
  adminGrantReason        String?

  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  user                    User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  listing                 VehicleListing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([listingId, promotionType, lifecycleStatus])
  @@index([userId, promotionType, lifecycleStatus])
  @@index([lifecycleStatus, expiresAt])
  @@unique([paymentProvider, paymentReferenceId])
}

model ListingPromotionEntitlement {
  id              String                   @id @default(cuid())
  purchaseId      String
  listingId       String?
  promotionType   ListingPromotionType
  lifecycleStatus PromotionLifecycleStatus @default(PENDING_ACTIVATION)

  activatedAt     DateTime?
  expiresAt       DateTime?
  terminatedAt    DateTime?

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  purchase        ListingPromotionPurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  listing         VehicleListing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([listingId, promotionType, lifecycleStatus])
}

model ListingPromotionLock {
  id        String   @id @default(cuid())
  lockKey   String   @unique
  listingId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PaymentWebhookEvent {
  id              String               @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  status          PaymentWebhookStatus @default(RECEIVED)
  lockedBy        String?
  lockedAt        DateTime?
  lockExpiresAt   DateTime?
  nextRetryAt     DateTime?
  attemptCount    Int                  @default(0)
  payloadHash     String?
  lastErrorCode   String?
  lastError       String?
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, nextRetryAt])
  @@index([lockExpiresAt])
}

enum EquipmentFeatureStatus {
  STANDARD
  OPTIONAL
  NOT_AVAILABLE
  PACKAGE_DEPENDENT
  MARKET_DEPENDENT
  PERIOD_DEPENDENT
  UNKNOWN
}

enum PeriodStatus {
  PERIOD_VERIFIED
  PERIOD_PROBABLE
  PERIOD_AMBIGUOUS
}

enum EvidenceStance {
  SUPPORTS
  REFUTES
  NEUTRAL
}

enum ComparisonType {
  LOWER_TRIM
  HIGHER_TRIM
}

model VehicleTrimEquipment {
  id               String          @id @default(uuid())
  vehicleVariantId String
  trimId           String
  market           String          @default("TR")
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  equipmentRevision String?
  periodStatus     PeriodStatus    @default(PERIOD_VERIFIED)
  status           ApprovalStatus  @default(PENDING)
  highlights       Json?
  signatures       Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variant          VehicleVariant  @relation(fields: [vehicleVariantId], references: [id])
  features         EquipmentFeature[]
  comparisons      TrimComparison[]

  @@index([vehicleVariantId, status])
}

model EquipmentFeature {
  id                     String                 @id @default(uuid())
  trimEquipmentId        String
  featureCode            String
  featureName            String
  category               String
  status                 EquipmentFeatureStatus
  valueText              String?
  valueNumber            Float?
  unit                   String?
  valueJson              Json?
  availabilityConditions Json?
  optionPackageName      String?
  optionPackageCode      String?
  relevanceBasis         Json
  confidenceScore        Int                    @default(0)

  trimEquipment          VehicleTrimEquipment   @relation(fields: [trimEquipmentId], references: [id], onDelete: Cascade)
  claims                 EquipmentClaim[]

  @@index([trimEquipmentId, featureCode])
}

model EquipmentClaim {
  id                 String               @id @default(uuid())
  equipmentFeatureId String
  claimText          String
  featureStatus      EquipmentFeatureStatus

  feature            EquipmentFeature     @relation(fields: [equipmentFeatureId], references: [id], onDelete: Cascade)
  evidences          EquipmentEvidence[]
}

model EquipmentEvidence {
  id               String            @id @default(uuid())
  equipmentClaimId String
  rawSourceId      String
  sourceKind       SourceKind
  sourceRank       Int
  stance           EvidenceStance    @default(SUPPORTS)

  claim            EquipmentClaim    @relation(fields: [equipmentClaimId], references: [id], onDelete: Cascade)
  rawSource        RawSource         @relation(fields: [rawSourceId], references: [id], onDelete: Cascade)
}

model TrimComparison {
  id               String               @id @default(uuid())
  trimEquipmentId  String
  targetTrimName   String
  comparisonType   ComparisonType
  featureIds       Json

  trimEquipment    VehicleTrimEquipment @relation(fields: [trimEquipmentId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  adminUserId     String
  adminEmail      String?
  action          String
  before          Json?
  after           Json?
  changedFields   String[] @default([])
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminUserId])
  @@index([createdAt])
}

model AdminUserNote {
  id               String   @id @default(uuid())
  userId           String
  createdByAdminId String
  adminEmail       String?
  content          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation("UserAdminNotes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdByAdminId])
}

model AdminUserMessage {
  id               String   @id @default(uuid())
  userId           String
  createdByAdminId String
  adminEmail       String?
  subject          String
  message          String
  sendInApp        Boolean  @default(true)
  sendEmail        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user             User     @relation("UserAdminMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdByAdminId])
}

model CustomerNoCounter {
  period    String   @id // YYMM format, e.g. "2608"
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DataQualitySnapshot {
  id              String   @id @default(uuid())
  qualityScore    Float
  totalDuplicates Int
  missingTrims    Int
  missingEngines  Int
  missingTrans    Int
  orphanRecords   Int
  suspiciousYears Int
  issuesJson      Json
  createdAt       DateTime @default(now())
}


