{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "update": {
    "main": {
      "branch": "main"
    },
    "preview": {
      "branch": "preview"
    },
    "production": {
      "branch": "production"
    }
  }
}
