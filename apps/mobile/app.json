{
  "expo": {
    "name": "TorqueScout",
    "slug": "torquescout-local",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.torquescout.mobile"
    },
    "android": {
      "package": "com.torquescout.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {}
    }
  }
}
